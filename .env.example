# Sign-ups: Google Apps Script web app that records rows and sends email.
# Setup: docs/signups.md
SIGNUP_WEBHOOK_URL=
SIGNUP_WEBHOOK_SECRET=

# Portal database (MongoDB Atlas connection string) and database name.
MONGODB_URI=
MONGODB_DB=exambites

# Auth: a long random secret (openssl rand -base64 32) and the site's public URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://exambites.vercel.app

# One-time token for creating the first admin at /admin/setup. Remove after use.
ADMIN_SETUP_TOKEN=

# Email via Resend. Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Exambites <hello@exambites.com>
# Where new sign-up alerts go.
ADMIN_NOTIFY_EMAIL=

# Lesson videos (Bunny Stream). Library ID: Stream → your library → API.
# Token key: Stream → library → Security → enable "Embed view token
# authentication" and copy the key. Without it, embeds aren't signed.
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
